diff --git a/intern/cycles/device/CMakeLists.txt b/intern/cycles/device/CMakeLists.txt
index fdba8c60..ad36582d 100644
--- a/intern/cycles/device/CMakeLists.txt
+++ b/intern/cycles/device/CMakeLists.txt
@@ -111,6 +111,16 @@ set(SRC_METAL
   metal/util.h
 )
 
+set(SRC_METAL_WM
+  metal_wm/device.cpp
+  metal_wm/device.h
+  metal_wm/device_impl.cpp
+  metal_wm/device_impl.h
+  metal_wm/queue.cpp
+  metal_wm/queue.h
+  metal_wm/wm.h
+)
+
 set(SRC_OPTIX
   optix/device.cpp
   optix/device.h
@@ -172,12 +182,34 @@ if(WITH_CYCLES_DEVICE_HIPRT)
 endif()
 
 if(WITH_CYCLES_DEVICE_METAL)
-  list(APPEND LIB
-    PRIVATE ${METAL_LIBRARY}
-  )
-  list(APPEND SRC
-    ${SRC_METAL}
-  )
+  if(WITH_CYCLES_DEVICE_METAL_WM)
+    # The Metal device written against winemetal (Porthole): no Objective-C, no Metal headers.
+    # metal_wm/winemetal holds the interface subset it needs; on Windows its implementation talks to
+    # winemetal's unix side directly, on macOS (tests) the native winemetal library is linked.
+    list(APPEND INC
+      metal_wm/winemetal
+    )
+    if(WIN32)
+      list(APPEND SRC
+        metal_wm/winemetal/winemetal_win.cpp
+        metal_wm/winemetal/winemetal.h
+      )
+    else()
+      list(APPEND LIB
+        PRIVATE ${CYCLES_WINEMETAL_LIBRARIES}
+      )
+    endif()
+    list(APPEND SRC
+      ${SRC_METAL_WM}
+    )
+  else()
+    list(APPEND LIB
+      PRIVATE ${METAL_LIBRARY}
+    )
+    list(APPEND SRC
+      ${SRC_METAL}
+    )
+  endif()
 endif()
 
 if(WITH_CYCLES_DEVICE_ONEAPI)
