diff --git a/CMakeLists.txt b/CMakeLists.txt
index 141fdaf9..0026100b 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -698,6 +698,13 @@ endif()
 # Apple Metal
 if(APPLE)
   option(WITH_CYCLES_DEVICE_METAL "Enable Cycles Apple Metal compute support" ON)
+  option(WITH_CYCLES_DEVICE_METAL_WM "Use the Metal device written against winemetal (Porthole) instead of the Objective-C one" OFF)
+elseif(WIN32)
+  # Windows programs running under Porthole reach the Mac's GPU through winemetal.
+  option(WITH_CYCLES_DEVICE_METAL_WM "Cycles Metal device written against winemetal (Porthole)" ON)
+  if(WITH_CYCLES_DEVICE_METAL_WM)
+    set(WITH_CYCLES_DEVICE_METAL ON)
+  endif()
 endif()
 
 # oneAPI
diff --git a/intern/cycles/CMakeLists.txt b/intern/cycles/CMakeLists.txt
index 77cad246..7598ecdb 100644
--- a/intern/cycles/CMakeLists.txt
+++ b/intern/cycles/CMakeLists.txt
@@ -274,6 +274,10 @@ endif()
 
 if(WITH_CYCLES_DEVICE_METAL)
   add_definitions(-DWITH_METAL)
+  if(WITH_CYCLES_DEVICE_METAL_WM AND APPLE)
+    # winemetal built natively for macOS (its calls are plain function calls, not imports of winemetal.dll)
+    add_definitions(-DDXMT_NATIVE=1)
+  endif()
 endif()
 
 if(WITH_CYCLES_DEVICE_ONEAPI)
